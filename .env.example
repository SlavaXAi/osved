APP_ENV=production
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_ID=
OPENROUTER_API_KEY=
MONID_API_KEY=
# Optional paid fallback when YouTube RSS is unavailable from this host.
YOUTUBE_RSS_FALLBACK_ENABLED=false

# Model IDs are explicit; availability depends on your OpenRouter account.
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_CARD_MODEL=openai/gpt-5.6-luna
OPENROUTER_SEARCH_MODEL=openai/gpt-5.6-luna
OPENROUTER_FALLBACK_MODEL=openai/gpt-4.1-mini

DATA_DIR=data
SOURCES_FILE=config/sources.yaml
INTERESTS_FILE=config/interests.yaml
STYLE_PROFILE_FILE=config/style-profile.yaml
SENSORY_SOURCES_FILE=config/sensory-sources.yaml
CONTOURS_FILE=config/contours.yaml
SEARCH_AGENTS_FILE=config/search-agents.yaml
X_AUTHORS_FILE=config/x-authors.yaml
WEEKLY_PERSONAS_FILE=config/weekly-personas.yaml
FRONTIER_IDEAS_FILE=config/frontier-ideas.yaml
DELIVERY_FORMAT=regular
NEWS_DELIVERY_MODE=hybrid
LOG_LEVEL=INFO

# Schedule is disabled until: osved schedule-enable --live
SCHEDULE_TIMEZONE=Europe/Moscow
RADAR_TIMES=["10:00","12:00","14:00","16:00","18:00","20:00"]
RESEARCH_TIMES=["11:00","15:00","19:00"]
DELIVERY_TIMES=["12:30","16:30","20:00"]
RADAR_COLLECT_LIMIT=100
SCHEDULED_PRIORITY_LENSES=[]
SCHEDULED_SEARCH_ENABLED=true
SCHEDULED_SEARCH_MAX_AGENTS=2
SCHEDULED_SEARCH_MAX_COST_USD=0.06
SCHEDULED_NEWS_DELIVERY_BATCH_SIZE=5
NEWS_EXTRA_BATCH_SIZE=3

BUDGET_TARGET_USD=8
BUDGET_WARNING_USD=9
BUDGET_HARD_STOP_USD=20
SENSORY_MONTHLY_CAP_USD=5
SENSORY_DAILY_CAP_USD=0.30
VIDEO_REPORTS_ENABLED=true
VIDEO_REPORT_BUDGET_ENABLED=true
VIDEO_REPORT_MAX_COST_USD=0.50
DETAILS_ENABLED=true
DETAILS_MAX_DAILY_NEW=5
DETAILS_MAX_COST_USD=0.02
# New in-card research tiers; existing global/monthly limits also apply.
NEWS_READER_MAX_SEARCHES=2
NEWS_READER_EXPANDED_MAX_SCRAPES=6
NEWS_READER_ARTICLE_MAX_SCRAPES=8
NEWS_READER_EXPANDED_MAX_COST_USD=0.05
NEWS_READER_ARTICLE_MAX_COST_USD=0.08
CONCEPT_BRIEFS_ENABLED=true
CONCEPT_BRIEFS_MAX_COST_USD=0.02

# Optional alternative to Monid for Telegram reading; keep both blank normally.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=data/telegram-reader.session

# Manual media downloads (no background download of feeds)
MEDIA_DOWNLOADS_ENABLED=true
MEDIA_YOUTUBE_MONID_ENABLED=true
MEDIA_MAX_FILE_BYTES=1900000000
MEDIA_MAX_STORAGE_BYTES=4500000000
MEDIA_MIN_FREE_BYTES=1000000000
MEDIA_TIMEOUT_SECONDS=1800
# Optional private local Telegram Bot API; leave empty for the standard API
TELEGRAM_API_BASE_URL=

# On-demand editions; opening commands makes no paid calls
MENU_BATCHES_ENABLED=true
MENU_PREPARATION_MAX_COST_USD=0.25
BIOGRAPHY_ENABLED=false
BIOGRAPHY_MAX_COST_USD=0.25

# Local daily reranking; configure config/daily-selection.yaml first.
DAILY_PERSONALIZATION_ENABLED=false
DAILY_SELECTION_FILE=config/daily-selection.yaml

# Contextual Russian X reposts with actual media; only links sent by the owner.
X_REPOSTS_ENABLED=false
X_REPOST_MAX_COST_USD=0.02

# Optional Yandex Music access; alternatively use data/yandex-music-token.json.
YANDEX_MUSIC_TOKEN=
